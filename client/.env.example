# ──────────────────────────────────────────────────────────────
#  CLIENT (frontend) environment variables
#  Copy this file to `.env` and fill in real values.
#  Vite exposes any var prefixed with VITE_ to the client via
#  import.meta.env.VITE_*. API calls use relative /api paths resolved
#  by the Vite dev proxy (see vite.config.js) in development, and by
#  the Express static/SPA server in production. Firebase config is
#  read from VITE_FIREBASE_* below (src/firebase/firebaseConfig.js);
#  a built-in fallback is used when these are unset, so the app runs
#  out of the box — set your own for production.
# ──────────────────────────────────────────────────────────────

# Firebase web config — read by src/firebase/firebaseConfig.js.
# Optional in dev (a fallback config is used if unset); set your own
# project's values for production.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────
#  InkWell AI — the writing studio's copilot.
#
#  NOTHING HERE NEEDS SETTING. The provider key lives on the SERVER
#  (server/.env.example: AI_PROVIDER + a provider key) and the client
#  reaches it at the relative route /api/v1/ai/complete. A relative path
#  matters: the production client is built in a separate Docker stage with
#  no build args, so a VITE_* value could never be baked in.
#
#  With the server left unconfigured, the copilot asks
#  GET /api/v1/ai/status, sees no provider, and shows its honest offline
#  state. The editor, autosave and publishing are unaffected either way.
#
#  The variables below are for local experiments only:
#
#  1. A PROXY YOU OWN — overrides the built-in route. It must accept
#     POST { system, prompt, history } and answer with JSON holding the
#     reply in one of: { output } | { text } | { output_text }.
#     VITE_AI_BASE_URL=https://your-server.example.com/api/ai/draft
#
#  2. DIRECT PROVIDER — bring-your-own-key from the browser. Fine for
#     local experiments; NOT for production (the key ships in the page
#     bundle to every visitor).
#       VITE_AI_PROVIDER=openai     # "openai" | "gemini" | "anthropic"
#       VITE_AI_API_KEY=            # the provider key — never commit it
#       VITE_AI_MODEL=              # e.g. gpt-4o-mini / gemini-2.0-flash /
#                                   # claude-3-5-haiku-20241022
#
#  "Research Sources" is server-only end to end — the search key never
#  reaches the browser, so there is no client variable for it.
#
#  Do NOT put real keys in this file or in any committed .env — keys are
#  read from the environment only.
# ──────────────────────────────────────────────────────────────
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
VITE_AI_MODEL=
VITE_AI_BASE_URL=